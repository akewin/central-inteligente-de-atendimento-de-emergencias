# Database connection
DB_HOST=HostDaConexaoPostgres
DB_PORT=5432
DB_USER=UsernameDaConexaoPostgres
DB_PASSWORD=SenhaDaConexaoPostgres
DB_NAME=NomeDoBancoDeDados

# Rodar serviço db utilizando Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=admin_panel_db

# Roda seed de usuários para desenvolvimento. Setar como false em produção
RUN_USERS_SEED=true
HOSPITAL_USERS_DEFAULT_PASSWORD=Hospital@123

# Cria as seis equipes fictícias do protótipo. Manter false em produção.
RUN_EMERGENCY_UNITS_SEED=true

# Application
API_PORT=PortaDaApi

# JWT
JWT_SECRET_KEY=ChaveSecretaJWT

# CORS
WEB_APP_URL=UrlDoFrontend

# Redefinição de senha via e-mail 
RESEND_API_KEY=ChaveDaApiDoResend
RESEND_FROM_EMAIL=EmailRegistradoNoServicoResend

# IA (Groq)
GROQ_API_KEY=ChaveDaApiGroq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1/
GROQ_TIMEOUT_SECONDS=15

# Mapa (OpenStreetMap/Overpass/OSRM). Os padrões públicos servem apenas para desenvolvimento.
OVERPASS_BASE_URLS=https://overpass-api.de/api/,https://overpass.private.coffee/api/
OSRM_BASE_URL=https://router.project-osrm.org/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/
MAP_HTTP_TIMEOUT_SECONDS=18
MAP_USER_AGENT=FHO-Emergency-Academic-Prototype/1.0
